    "test:collection-sync": "node scripts/collection-sync-test.js",
    "test:bili-session": "node scripts/bili-session-test.js",
    "test:dependency-manifest": "node scripts/dependency-manifest-test.js",
    "test:update-migration": "node scripts/update-manager-test.js",
    "test:standalone-updater": "node scripts/standalone-updater-test.js",
    "test:bili-client": "node scripts/bili-client-test.js",
