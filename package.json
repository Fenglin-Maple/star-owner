    "test:knowledge-api": "node scripts/knowledge-api-test.js",
    "test:hardware": "node scripts/hardware-capabilities-test.js",
    "test:asr-models": "node scripts/asr-models-test.js",
    "test:v1-0-9-controls": "node scripts/v1-0-9-controls-test.js",
    "test:v1-1-0-startup": "node scripts/v1-1-0-startup-test.js",
    "test:local-toolbox": "node scripts/local-toolbox-test.js",
    "test:multipart": "node scripts/multipart-test.js",
    "test:shared-knowledge": "node scripts/shared-knowledge-test.js",
    "test:renderer-state": "node scripts/renderer-state-test.js",
